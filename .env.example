APP_NAME=AREPORT
APP_ENV=local
APP_KEY=base64:+uwTusy47jVP4UHRhotNfJNcRX4//7IB2MuJma7flP4=
APP_DEBUG=true
APP_URL=https://demo.areport.net

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dpm
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

#UPLOAD ENABLE
UPLOAD=1
#LEI CODE
LEI_CODE=12345678912345678912

# Private plugins loaded from sibling folders (skipped when missing)
AREPORT_PLUGIN_PATHS=../areport-pro
# AReport Pro DPM translation owner
AREPORT_PRO_DPM_OWNER_URL=https://www.fba.ba
# Public demo: share this user's reports with everyone; visitors are read-only on shared things
AREPORT_DEMO_SHARED_USER_ID=0
AREPORT_DEMO_READONLY=true
AREPORT_DEMO_ADMINS=
# Contact form recipient
AREPORT_CONTACT_TO=info@areport.net
# AI translation of labels (claude or openai); can also be set under Settings › AI translation
AREPORT_PRO_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AREPORT_PRO_AI_MODEL=claude-opus-5-5
OPENAI_API_KEY=
AREPORT_PRO_AI_OPENAI_MODEL=gpt-5-mini
